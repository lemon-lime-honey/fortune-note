# Ignore everything by default
*

# Whitelist git tracking
!.gitignore
!README.md
!Cargo.toml
!Cargo.lock

# Rust source code
!crates/
!crates/**/
!crates/**/*.rs
!crates/**/Cargo.toml
!crates/**/Cargo.lock
!crates/**/*.md

# Build and deployment scripts
!scripts/
!scripts/**

# Android app sources
!android/
!android/**/
!android/**/*.kts
!android/**/*.kt
!android/**/*.xml
!android/**/*.properties
android/local.properties
android/.gradle/
android/**/build/
!android/gradle/
!android/gradle/**
!android/gradlew
!android/gradlew.bat
!android/**/proguard-rules.pro
!android/**/jniLibs/
!android/**/jniLibs/**
